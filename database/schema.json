{
  "schemaVersion": "0.2.0",
  "description": "Canonical puzzle/solution catalog and solver retrieval index for Opus Magnum Codex.",
  "identity": {
    "puzzleId": "puz-<first16 sha256>",
    "solutionId": "sol-<first16 sha256>",
    "canonicalStructuralHash": "translation/rotation invariant hash preserving program timing",
    "canonicalMechanismHash": "translation/rotation invariant hash with normalized program timing",
    "rule": "Content hashes identify exact files; canonical hashes identify reusable structures and mechanisms."
  },
  "puzzle": {
    "required": ["id", "sha256", "name", "version", "sourceDataset"],
    "fields": {
      "id": "string",
      "sha256": "hex64",
      "name": "string",
      "file": "string|null",
      "version": "integer|null",
      "size": "integer|null",
      "sourceDataset": "string",
      "redistribution": "string",
      "tags": "string[]"
    }
  },
  "solution": {
    "required": ["id", "sha256", "puzzleId", "metrics", "sourceDataset"],
    "fields": {
      "id": "string",
      "sha256": "hex64",
      "puzzleId": "string",
      "file": "string|null",
      "version": "integer|null",
      "size": "integer|null",
      "metrics": {
        "cycles": "integer|null",
        "cost": "integer|null",
        "area": "integer|null",
        "instructions": "integer|null"
      },
      "canonicalStructuralHash": "string|null",
      "canonicalMechanismHash": "string|null",
      "structure": {
        "partTypes": "string[]",
        "partCount": "integer|null",
        "armCount": "integer|null",
        "cycleSlots": "integer|null",
        "instructionCount": "integer|null"
      },
      "validation": {
        "parserClean": "boolean|null",
        "omsim": "string|null",
        "replayEquivalent": "boolean|null"
      },
      "sourceDataset": "string",
      "redistribution": "string",
      "tags": "string[]"
    }
  },
  "catalog": {
    "fields": {
      "generatedAt": "iso8601|null",
      "puzzles": "puzzle[]",
      "solutions": "solution[]",
      "summary": {
        "puzzleCount": "integer",
        "solutionCount": "integer",
        "validatedSolutionCount": "integer"
      }
    }
  },
  "solverIndex": {
    "purpose": "Compact retrieval layer used by the solver to search reusable mechanisms without scanning every exact solution.",
    "grouping": ["puzzleKey", "canonicalMechanismHash"],
    "mechanismFields": {
      "solutionCount": "integer",
      "structuralVariantCount": "integer",
      "partTypes": "string[]",
      "armCount": "{min,max}",
      "partCount": "{min,max}",
      "cycleSlots": "{min,max}",
      "instructionCount": "{min,max}",
      "bestByMetric": "solutionRef by cycles/cost/area/instructions",
      "paretoFrontier": "solutionRef[]"
    }
  }
}

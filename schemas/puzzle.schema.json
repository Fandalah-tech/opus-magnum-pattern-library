{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opus-codex.local/schemas/puzzle.schema.json",
  "title": "Opus Codex Parsed Puzzle",
  "type": "object",
  "required": [
    "schemaVersion",
    "format",
    "source",
    "name",
    "creatorId",
    "availableParts",
    "reagents",
    "products",
    "outputScale",
    "production",
    "trailingBytes"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1.1" },
    "format": {
      "type": "object",
      "required": ["kind", "version"],
      "properties": {
        "kind": { "const": "puzzle" },
        "version": { "const": 3 }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["name", "sha256", "size"],
      "properties": {
        "name": { "type": ["string", "null"] },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "name": { "type": "string", "minLength": 1 },
    "creatorId": { "type": "string", "pattern": "^[0-9]+$" },
    "availableParts": { "$ref": "#/$defs/availableParts" },
    "reagents": {
      "type": "array",
      "items": { "$ref": "#/$defs/molecule" }
    },
    "products": {
      "type": "array",
      "items": { "$ref": "#/$defs/molecule" }
    },
    "outputScale": { "type": "integer", "minimum": 1 },
    "production": { "type": "boolean" },
    "trailingBytes": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false,
  "$defs": {
    "coordinate": {
      "type": "array",
      "items": { "type": "integer", "minimum": -128, "maximum": 127 },
      "minItems": 2,
      "maxItems": 2
    },
    "availableParts": {
      "type": "object",
      "required": ["rawFlags", "arms", "glyphs", "unknownGlyphFlags"],
      "properties": {
        "rawFlags": { "type": "integer", "minimum": 0 },
        "arms": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "glyphs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "unknownGlyphFlags": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "atom": {
      "type": "object",
      "required": ["id", "element", "position"],
      "properties": {
        "id": { "type": "string", "pattern": "^a[0-9]+$" },
        "element": {
          "enum": [
            "salt",
            "air",
            "earth",
            "fire",
            "water",
            "quicksilver",
            "gold",
            "silver",
            "copper",
            "iron",
            "tin",
            "lead",
            "vitae",
            "mors",
            "repeat",
            "quintessence"
          ]
        },
        "position": { "$ref": "#/$defs/coordinate" }
      },
      "additionalProperties": false
    },
    "bond": {
      "type": "object",
      "required": ["type", "rawCode", "from", "to"],
      "properties": {
        "type": { "enum": ["normal", "triplex"] },
        "rawCode": { "enum": [1, 2, 4, 6, 8, 10, 12, 14] },
        "triplexChannels": {
          "type": "array",
          "items": { "enum": ["red", "black", "yellow"] },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        },
        "from": { "$ref": "#/$defs/coordinate" },
        "to": { "$ref": "#/$defs/coordinate" }
      },
      "additionalProperties": false
    },
    "molecule": {
      "type": "object",
      "required": ["id", "atoms", "bonds"],
      "properties": {
        "id": { "type": "string", "pattern": "^(reagent|product)-[0-9]+$" },
        "atoms": { "type": "array", "items": { "$ref": "#/$defs/atom" } },
        "bonds": { "type": "array", "items": { "$ref": "#/$defs/bond" } }
      },
      "additionalProperties": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opus-codex.local/schemas/solution.schema.json",
  "title": "Opus Codex Solution",
  "type": "object",
  "required": ["schemaVersion", "id", "puzzleId", "parts"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "id": { "type": "string", "minLength": 1 },
    "puzzleId": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "source": {
      "type": "object",
      "properties": {
        "fileName": { "type": "string" },
        "sha256": { "type": "string" },
        "formatVersion": { "type": ["integer", "null"] }
      },
      "additionalProperties": false
    },
    "parts": {
      "type": "array",
      "items": { "$ref": "#/$defs/part" }
    },
    "claimedMetrics": { "$ref": "#/$defs/metrics" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false,
  "$defs": {
    "hex": {
      "type": "object",
      "required": ["q", "r"],
      "properties": {
        "q": { "type": "integer" },
        "r": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "instruction": {
      "type": "object",
      "required": ["cycle", "opcode"],
      "properties": {
        "cycle": { "type": "integer", "minimum": 0 },
        "opcode": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "part": {
      "type": "object",
      "required": ["id", "type", "position", "rotation"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "position": { "$ref": "#/$defs/hex" },
        "rotation": { "type": "integer", "minimum": 0, "maximum": 5 },
        "length": { "type": ["integer", "null"], "minimum": 1 },
        "track": {
          "type": "array",
          "items": { "$ref": "#/$defs/hex" }
        },
        "program": {
          "type": "array",
          "items": { "$ref": "#/$defs/instruction" }
        },
        "metadata": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "cost": { "type": "integer", "minimum": 0 },
        "cycles": { "type": "integer", "minimum": 0 },
        "area": { "type": "integer", "minimum": 0 },
        "instructions": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
